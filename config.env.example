# Copy to config.env (git-ignored) and fill in. Every script reads this file.
PROJECT_ID=my-project
PROJECT_NUMBER=123456789012
ORG_ID=123456789012
REGION=me-west1

GATEWAY=agent-gateway
STAGING_BUCKET=gs://my-project-agent-demo-staging
WEB_SERVICE=agent-demo-web
WEB_SA_NAME=agent-demo-web-sa
SQL_INSTANCE=agent-demo-sql
DB_NAME=agent_demo
DB_USER=agent2_app
DB_SECRET=agent2-db-password
A1_POLICY=a1-to-agents

# Who may open the web app through IAP, and the email you will sign in with
IAP_MEMBER=user:alice@example.com
DEMO_USER_EMAIL=alice@example.com

# Filled in by the scripts as they run
AGENT1_ID=
AGENT2_ID=
AGENT3_ID=
AGENT2_ENDPOINT=
AGENT3_ENDPOINT=
